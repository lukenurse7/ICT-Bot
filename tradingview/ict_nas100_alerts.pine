//@version=5
indicator("ICT NAS100 - KZ Signals", overlay=true, max_bars_back=500)

// Inputs
slBuffer = input.float(50.0, "SL Buffer (pts)")
minRisk  = input.float(30.0, "Min Risk (pts)")
tpR      = input.float(2.0,  "TP Risk Multiple")
kzStart  = input.int(8,      "KZ Start Hour NY")
kzEnd    = input.int(11,     "KZ End Hour NY")

// NY Kill Zone
nyHour    = hour(time, "America/New_York")
nyMin     = minute(time, "America/New_York")
nyDow     = dayofweek(time, "America/New_York")
isWeekday = nyDow >= dayofweek.monday and nyDow <= dayofweek.friday
inKZ      = isWeekday and (nyHour * 60 + nyMin) >= kzStart * 60 and (nyHour * 60 + nyMin) < kzEnd * 60

// Swing detection (1-bar each side)
isSwingH = high > high[1] and high > high[2] and high > high[3]
isSwingL = low  < low[1]  and low  < low[2]  and low  < low[3]

var float swingH = na
var float swingL = na
if isSwingH
    swingH := high
if isSwingL
    swingL := low

// Track sweep
var bool  swept      = false
var bool  sweptBear  = false
var bool  sweptBull  = false
var float sweepWick  = na
var int   sweepBar   = 0

if inKZ and not swept
    if not na(swingH) and high > swingH
        swept     := true
        sweptBear := true
        sweepWick := high
        sweepBar  := bar_index
    if not na(swingL) and low < swingL
        swept     := true
        sweptBull := true
        sweepWick := low
        sweepBar  := bar_index

// MSS reference (pre-sweep swing)
var float mssRef        = na
var bool  mssConfirmed  = false

if swept and not mssConfirmed
    if sweptBear and isSwingL
        mssRef := low
    if sweptBull and isSwingH
        mssRef := high

if swept and not mssConfirmed and not na(mssRef) and bar_index > sweepBar
    if sweptBear and close < mssRef
        mssConfirmed := true
    if sweptBull and close > mssRef
        mssConfirmed := true

// FVG detection
var float fvgTop   = na
var float fvgBot   = na
var float fvgMid   = na
var bool  fvgFound = false

if mssConfirmed and not fvgFound and bar_index > sweepBar + 1
    if sweptBear and low[2] > high[0]
        fvgTop   := low[2]
        fvgBot   := high[0]
        fvgMid   := (fvgTop + fvgBot) / 2.0
        fvgFound := true
    if sweptBull and high[2] < low[0]
        fvgTop   := low[0]
        fvgBot   := high[2]
        fvgMid   := (fvgTop + fvgBot) / 2.0
        fvgFound := true

// Entry at 50% FVG
var bool  entryFired = false
var float entryPrice = na
var float entrySL    = na
var float entryTP    = na
var float entryRisk  = na

if fvgFound and not entryFired and inKZ
    reachedFVG = sweptBear ? high >= fvgMid : low <= fvgMid
    if reachedFVG
        entryPrice := fvgMid
        entrySL    := sweptBear ? sweepWick + slBuffer : sweepWick - slBuffer
        entryRisk  := math.abs(entryPrice - entrySL)
        if entryRisk >= minRisk
            entryTP    := sweptBear ? entryPrice - entryRisk * tpR : entryPrice + entryRisk * tpR
            entryFired := true

// Reset at end of KZ or new day
newDay = ta.change(time("D")) != 0
if not inKZ or newDay
    swept        := false
    sweptBear    := false
    sweptBull    := false
    sweepWick    := na
    sweepBar     := 0
    mssRef       := na
    mssConfirmed := false
    fvgTop       := na
    fvgBot       := na
    fvgMid       := na
    fvgFound     := false
    entryFired   := false
    entryPrice   := na
    entrySL      := na
    entryTP      := na
    entryRisk    := na

// Plots
justFired = entryFired and not entryFired[1]
plotshape(justFired and sweptBear, "SHORT", shape.triangledown, location.abovebar, color.red,   size=size.normal)
plotshape(justFired and sweptBull, "LONG",  shape.triangleup,   location.belowbar, color.green, size=size.normal)

plot(fvgFound ? fvgTop : na, "FVG Top", color.new(color.orange, 70), 1, plot.style_linebr)
plot(fvgFound ? fvgBot : na, "FVG Bot", color.new(color.orange, 70), 1, plot.style_linebr)
plot(fvgFound ? fvgMid : na, "FVG Mid", color.new(color.yellow, 50), 1, plot.style_linebr)

// Alert message
dir    = sweptBear ? "SHORT" : "LONG"
rrVal  = entryRisk > 0 ? math.round(math.abs(entryPrice - entryTP) / entryRisk, 2) : 0.0
msg    = '{"direction":"' + dir + '","symbol":"NAS100","entry":' + str.tostring(math.round(entryPrice, 2)) + ',"sl":' + str.tostring(math.round(entrySL, 2)) + ',"tp":' + str.tostring(math.round(entryTP, 2)) + ',"risk":' + str.tostring(math.round(entryRisk, 2)) + ',"rr":' + str.tostring(rrVal) + ',"time":"' + str.format_time(time, "yyyy-MM-dd HH:mm", "America/New_York") + ' NY"}'

alertcondition(entryFired and not entryFired[1], "ICT Entry Signal", msg)
