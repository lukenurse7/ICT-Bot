//@version=6
strategy("ICT NAS100 - KZ Strategy", overlay=true, max_bars_back=500,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_order, commission_value=0,
     process_orders_on_close=false)

// Inputs
slBuffer = input.float(50.0,  "SL Buffer (pts)")
minRisk  = input.float(30.0,  "Min Risk (pts)")
tpR      = input.float(2.0,   "TP Risk Multiple")
kzStart  = input.int(8,       "KZ Start Hour NY")
kzEnd    = input.int(11,      "KZ End Hour NY")
swingK   = input.int(2,       "Swing Lookback Bars")

// NY Kill Zone
nyHour    = hour(time, "America/New_York")
nyMin     = minute(time, "America/New_York")
nyDow     = dayofweek(time, "America/New_York")
isWeekday = nyDow >= dayofweek.monday and nyDow <= dayofweek.friday
inKZ      = isWeekday and (nyHour * 60 + nyMin) >= kzStart * 60 and (nyHour * 60 + nyMin) < kzEnd * 60
newDay    = ta.change(time("D")) != 0

// Swing highs and lows (confirmed, k bars each side)
swingHigh = ta.pivothigh(high, swingK, swingK)
swingLow  = ta.pivotlow(low,  swingK, swingK)

// Track most recent confirmed swing before KZ
var float lastSwingH = na
var float lastSwingL = na

if not na(swingHigh)
    lastSwingH := swingHigh
if not na(swingLow)
    lastSwingL := swingLow

// ── Per-day state ──────────────────────────────────────────────
var bool  dayTraded  = false
var bool  swept      = false
var bool  sweptBear  = false
var bool  sweptBull  = false
var float sweepWick  = na
var int   sweepBar   = 0
var bool  mssOk      = false
var float mssRef     = na
var bool  fvgFound   = false
var float fvgMid     = na
var float fvgTop     = na
var float fvgBot     = na

// Reset each new day
if newDay
    dayTraded  := false
    swept      := false
    sweptBear  := false
    sweptBull  := false
    sweepWick  := na
    sweepBar   := 0
    mssOk      := false
    mssRef     := na
    fvgFound   := false
    fvgMid     := na
    fvgTop     := na
    fvgBot     := na

// ── Step 1: Sweep of swing level inside KZ ────────────────────
if inKZ and not swept and not dayTraded
    if not na(lastSwingH) and high > lastSwingH
        swept     := true
        sweptBear := true
        sweepWick := high
        sweepBar  := bar_index
    else if not na(lastSwingL) and low < lastSwingL
        swept     := true
        sweptBull := true
        sweepWick := low
        sweepBar  := bar_index

// ── Step 2: MSS — close breaks opposite swing after sweep ─────
if swept and not mssOk and bar_index > sweepBar
    if sweptBear
        sl = ta.pivotlow(low, swingK, swingK)
        if not na(sl) and sl[swingK] < sweepWick
            mssRef := sl[swingK]
        if not na(mssRef) and close < mssRef
            mssOk := true
    else
        sh = ta.pivothigh(high, swingK, swingK)
        if not na(sh) and sh[swingK] > sweepWick
            mssRef := sh[swingK]
        if not na(mssRef) and close > mssRef
            mssOk := true

// ── Step 3: FVG in impulse leg ────────────────────────────────
if mssOk and not fvgFound and bar_index > sweepBar + 1
    if sweptBear and low[2] > high[0]
        fvgTop   := low[2]
        fvgBot   := high[0]
        fvgMid   := (fvgTop + fvgBot) / 2.0
        fvgFound := true
    if sweptBull and high[2] < low[0]
        fvgTop   := low[0]
        fvgBot   := high[2]
        fvgMid   := (fvgTop + fvgBot) / 2.0
        fvgFound := true

// ── Step 4: Entry when price retraces to 50% FVG ─────────────
if fvgFound and not dayTraded and inKZ and strategy.position_size == 0
    entryPrice = fvgMid
    entrySL    = sweptBear ? sweepWick + slBuffer : sweepWick - slBuffer
    entryRisk  = math.abs(entryPrice - entrySL)
    if entryRisk >= minRisk
        entryTP = sweptBear ? entryPrice - entryRisk * tpR : entryPrice + entryRisk * tpR
        if sweptBear and high >= fvgMid
            strategy.entry("SHORT", strategy.short, limit=fvgMid, comment="ICT SHORT")
            strategy.exit("SX", "SHORT", limit=entryTP, stop=entrySL)
            dayTraded := true
        if sweptBull and low <= fvgMid
            strategy.entry("LONG", strategy.long, limit=fvgMid, comment="ICT LONG")
            strategy.exit("LX", "LONG", limit=entryTP, stop=entrySL)
            dayTraded := true

// ── Plots ─────────────────────────────────────────────────────
plot(fvgFound ? fvgTop : na, "FVG Top", color.new(color.orange, 60), 1, plot.style_linebr)
plot(fvgFound ? fvgBot : na, "FVG Bot", color.new(color.orange, 60), 1, plot.style_linebr)
plot(fvgFound ? fvgMid : na, "FVG Mid", color.new(color.yellow, 40), 1, plot.style_linebr)
bgcolor(inKZ ? color.new(color.blue, 93) : na, title="Kill Zone")
