//@version=6
strategy("ICT NAS100 - KZ Strategy", overlay=true, max_bars_back=500,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_order, commission_value=0,
     process_orders_on_close=false)

// Inputs
slBuffer  = input.float(50.0, "SL Buffer (pts)")
minRisk   = input.float(30.0, "Min Risk (pts)")
tpR       = input.float(2.0,  "TP Risk Multiple")
kzStart   = input.int(8,      "KZ Start Hour NY")
kzEnd     = input.int(11,     "KZ End Hour NY")
showDebug = input.bool(true,  "Show Debug Dots")

// ── NY Kill Zone ──────────────────────────────────────────────
nyHour    = hour(time, "America/New_York")
nyMin     = minute(time, "America/New_York")
nyDow     = dayofweek(time, "America/New_York")
isWeekday = nyDow >= dayofweek.monday and nyDow <= dayofweek.friday
inKZ      = isWeekday and (nyHour * 60 + nyMin) >= kzStart * 60 and (nyHour * 60 + nyMin) < kzEnd * 60
newDay    = ta.change(time("D")) != 0

// ── 5m swing levels (liquidity to sweep) ─────────────────────
f_5m_swings() =>
    isH = high > high[1] and high > high[2] and high > high[3]
    isL = low  < low[1]  and low  < low[2]  and low  < low[3]
    var float sH = na
    var float sL = na
    if ta.change(time("D")) != 0
        sH := na
        sL := na
    if isH
        sH := high
    if isL
        sL := low
    [sH, sL]

[ref5mH, ref5mL] = request.security(syminfo.tickerid, "5", f_5m_swings(), lookahead=barmerge.lookahead_off)

// ── Per-session state ─────────────────────────────────────────
var bool  swept        = false
var bool  sweptBear    = false
var bool  sweptBull    = false
var float sweepWick    = na   // the swept level (5m swing)
var float mssLevel     = na   // opposite extreme of sweep candle = MSS trigger
var int   sweepBar     = 0
var bool  mssConfirmed = false
var float fvgTop       = na
var float fvgBot       = na
var float fvgMid       = na
var bool  fvgFound     = false
var bool  entryFired   = false
var float entryPrice   = na
var float entrySL      = na
var float entryTP      = na
var float entryRisk    = na

if newDay
    swept        := false
    sweptBear    := false
    sweptBull    := false
    sweepWick    := na
    mssLevel     := na
    sweepBar     := 0
    mssConfirmed := false
    fvgTop       := na
    fvgBot       := na
    fvgMid       := na
    fvgFound     := false
    entryFired   := false
    entryPrice   := na
    entrySL      := na
    entryTP      := na
    entryRisk    := na

// ── Step 1: Sweep of 5m level inside KZ ──────────────────────
sweepFiredThisBar = false
if inKZ and not swept and not entryFired
    if not na(ref5mH) and high > ref5mH
        swept             := true
        sweptBear         := true
        sweepWick         := ref5mH
        mssLevel          := low          // MSS confirms when close < this candle's low
        sweepBar          := bar_index
        sweepFiredThisBar := true
    else if not na(ref5mL) and low < ref5mL
        swept             := true
        sweptBull         := true
        sweepWick         := ref5mL
        mssLevel          := high         // MSS confirms when close > this candle's high
        sweepBar          := bar_index
        sweepFiredThisBar := true

// ── Step 2: MSS — close beyond the sweep candle's opposite end ─
mssFiredThisBar = false
if swept and not mssConfirmed and bar_index > sweepBar
    if sweptBear and close < mssLevel
        mssConfirmed    := true
        mssFiredThisBar := true
    if sweptBull and close > mssLevel
        mssConfirmed    := true
        mssFiredThisBar := true

// ── Step 3: FVG in the impulse leg ───────────────────────────
fvgFiredThisBar = false
if mssConfirmed and not fvgFound
    if sweptBear and low[2] > high[0]
        fvgTop          := low[2]
        fvgBot          := high[0]
        fvgMid          := (fvgTop + fvgBot) / 2.0
        fvgFound        := true
        fvgFiredThisBar := true
    if sweptBull and high[2] < low[0]
        fvgTop          := low[0]
        fvgBot          := high[2]
        fvgMid          := (fvgTop + fvgBot) / 2.0
        fvgFound        := true
        fvgFiredThisBar := true

// ── Step 4: Entry at 50% FVG inside KZ ───────────────────────
if fvgFound and not entryFired and inKZ and strategy.position_size == 0
    reachedFVG = sweptBear ? high >= fvgMid : low <= fvgMid
    if reachedFVG
        entryPrice := fvgMid
        entrySL    := sweptBear ? sweepWick + slBuffer : sweepWick - slBuffer
        entryRisk  := math.abs(entryPrice - entrySL)
        if entryRisk >= minRisk
            entryTP    := sweptBear ? entryPrice - entryRisk * tpR : entryPrice + entryRisk * tpR
            entryFired := true
            if sweptBear
                strategy.entry("SHORT", strategy.short, comment="ICT SHORT")
                strategy.exit("SX", "SHORT", limit=entryTP, stop=entrySL)
            else
                strategy.entry("LONG", strategy.long, comment="ICT LONG")
                strategy.exit("LX", "LONG", limit=entryTP, stop=entrySL)

// ── Plots ─────────────────────────────────────────────────────
justFired = entryFired and not entryFired[1]

plotshape(showDebug and sweepFiredThisBar, "Sweep", shape.circle,       location.abovebar, color.blue,   size=size.tiny)
plotshape(showDebug and mssFiredThisBar,   "MSS",   shape.circle,       location.abovebar, color.yellow, size=size.tiny)
plotshape(showDebug and fvgFiredThisBar,   "FVG",   shape.circle,       location.abovebar, color.orange, size=size.small)
plotshape(justFired and sweptBear,         "SHORT", shape.triangledown, location.abovebar, color.red,    size=size.normal)
plotshape(justFired and sweptBull,         "LONG",  shape.triangleup,   location.belowbar, color.green,  size=size.normal)

plot(ref5mH, "5m Swing H", color.new(color.red,   70), 1, plot.style_linebr)
plot(ref5mL, "5m Swing L", color.new(color.green, 70), 1, plot.style_linebr)
plot(fvgFound ? fvgTop : na, "FVG Top", color.new(color.orange, 60), 1, plot.style_linebr)
plot(fvgFound ? fvgBot : na, "FVG Bot", color.new(color.orange, 60), 1, plot.style_linebr)
plot(fvgFound ? fvgMid : na, "FVG Mid", color.new(color.yellow, 40), 1, plot.style_linebr)

// TP and SL lines — visible from entry bar onwards
plot(entryFired ? entryTP  : na, "TP",    color.new(color.lime,  20), 2, plot.style_linebr)
plot(entryFired ? entrySL  : na, "SL",    color.new(color.red,   20), 2, plot.style_linebr)
plot(entryFired ? entryPrice : na, "Entry", color.new(color.white, 40), 1, plot.style_linebr)

bgcolor(inKZ ? color.new(color.blue, 93) : na, title="Kill Zone")
